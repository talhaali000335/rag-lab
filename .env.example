DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use SQLite locally. On AWS use your RDS URL:
# DATABASE_URL=postgres://user:pass@your-rds-host:5432/ragdb
DATABASE_URL=
RAG_API_KEY=dev-api-key
RATE_LIMIT_PER_MIN=30
# Optional real LLM (answers are still checked by the output guardrail)
USE_LLM=0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
